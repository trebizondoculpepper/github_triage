{
  "name": "@trebizondoculpepper/github-triage",
  "version": "0.1.0",
  "description": "Evidence-linked GitHub issue and pull request briefings for coding agents",
  "bugs": {
    "url": "https://github.com/trebizondoculpepper/github_triage/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trebizondoculpepper/github_triage.git"
  },
  "bin": {
    "github-triage": "dist/cli.mjs",
    "github-triage-mcp": "dist/mcp.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "dist/mcp.mjs",
    "third-party",
    "dist/datalog-*.mjs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "triage": "tsx src/cli.ts",
    "build": "vp pack src/cli.ts --format esm --out-dir dist && vp pack src/mcp.ts --format esm --out-dir dist --no-clean",
    "check": "vp check && tsc -p doc/reports/examples",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test run",
    "prepare": "vp config --hooks --no-agent",
    "smoke": "tsx scripts/smoke.ts dist/cli.mjs",
    "prepack": "npm run build",
    "package-test": "tsx scripts/package-test.ts",
    "release": "tsx scripts/release.ts",
    "make-prerelease": "tsx scripts/make-prerelease.ts",
    "mcp": "tsx src/mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "datascript": "1.8.1",
    "env-paths": "4.0.0",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "engines": {
    "node": ">=26"
  }
}
